# Copy to .env (or set as real environment variables in your deploy target).

# --- LLM (optional but recommended) -----------------------------------------
# The bot works with NO key set: every message falls back to a deterministic,
# grounded template. Setting this key lets the LLM phrase messages naturally;
# every LLM output is still validated and falls back automatically if it
# fails grounding/CTA/taboo checks.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=8

# --- /v1/metadata ------------------------------------------------------------
TEAM_NAME=Aryan Goel
TEAM_MEMBERS=Aryan Goel
BOT_VERSION=1.0.0
BOT_SUBMITTED_AT=2026-04-26T08:00:00Z
APPROACH=
